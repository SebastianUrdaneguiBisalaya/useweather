{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Shared by every package: each packages/*/tsconfig.json only extends this file and sets `include`.
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Web APIs only (fetch, Web Crypto, AbortSignal, URL): the packages must run on any runtime, so no @types/node.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Workspace packages resolve to their sources, so a package can be type-checked and tested without building the
    // ones it depends on first. Published builds keep these as external imports.
    "paths": {
      "@useweather/core": [
        "./packages/core/src/index.ts"
      ]
    },
    "skipLibCheck": true,

    "strict": true,
    "target": "ES2022",
    "types": [],
    "verbatimModuleSyntax": true
  }
}
