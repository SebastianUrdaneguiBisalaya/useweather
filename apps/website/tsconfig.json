{
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // Replaces the base `paths`, so the workspace sources are mapped again here:
    // the playground runs against the library sources with hot reload, no build step.
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@useweather/core": [
        "../../packages/core/src/index.ts"
      ],
      "@useweather/react": [
        "../../packages/react/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "../../tsconfig.base.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
